# ──────────────────────────────────────────────────────────────
# Backend (server-only) configuration.
# These variables are NEVER bundled into the browser because they
# do not use the VITE_ prefix. Copy this file to .env and fill in.
#
# The client only needs to change the model name and the key.
# Everything else keeps working as-is.
# ──────────────────────────────────────────────────────────────

# Your LLM API key (Gemini key during testing).
GEMINI_API_KEY=your_api_key_here

# The model name to use. Change this to switch models.
GEMINI_MODEL=gemini-2.5-flash

# Native Gemini REST base URL. Rarely needs changing.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Port the Express backend listens on.
PORT=8787
